{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "color": {
      "keys": "red"
    }
  },
  "logo": {
    "type": "kitty",
    "source": "~/debian/debian.png",
    "width": 32
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "╭──────────────",
      "outputColor": "red"
    },
    {
      "type": "os",
      "key": "├ OS",
      "format": ""
    },
    {
      "type": "wm",
      "key": "├ WM",
      "format": "{3}"
    },
    {
      "type": "wmtheme",
      "key": "├ WM Theme"
    },
    {
      "type": "de",
      "key": "├ DE",
      "format": "{2}"
    },
    {
      "type": "font",
      "key": "├ System Font",
      "format": "{2}"
    },
    {
      "type": "terminal",
      "key": "├ Terminal",
      "format": "{1}"
    },
    {
      "type": "terminalfont",
      "key": "├ Terminal Font",
      "format": "{2}"
    },
    {
      "type": "uptime",
      "key": "├ Uptime"
    },
    {
      "type": "custom",
      "format": "╰──────────────",
      "outputColor": "red"
    },
    {
      "type": "custom",
      "format": "╭──────────────",
      "outputColor": "red"
    },
    {
      "type": "cpu",
      "key": "├ CPU"
    },
    {
      "type": "gpu",
      "key": "├ GPU"
    },
    {
      "type": "memory", 
      "key": "├ Memory",
      "format": "{1}"
    },
    {
      "type": "swap",
      "key": "├ Swap",
      "format": "{1}"
    },
    {
      "type": "disk",
      "key": "├ Disk",
      "format": "{1} / {2} ({size-percentage} used)"
    },
    {
      "type": "localip",
      "key": "├ Local IP",
      "format": "{1} on {4}"
    },
    {
      "type": "battery",
      "key": "├ Battery",
      "format": "{4}, currently {5}"
    },
    {
      "type": "custom",
      "format": "╰──────────────",
      "outputColor": "red"
    },
    "break"
  ]
}
